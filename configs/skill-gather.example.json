{
  "providers": {
    "newapi": {
      "base_url": "https://api.renice.cc/v1",
      "api_key_env": "NEWAPI_API_KEY",
      "vision_model": "gpt-4o-mini",
      "asr_model": "faster-whisper:large-v3-turbo",
      "distiller_model": "gpt-4o-mini",
      "judge_model": "gpt-4o-mini"
    }
  },
  "defaults": {
    "provider": "newapi",
    "output_dir": "./skills",
    "run_dir": "./runs"
  },
  "topic_defaults": {
    "max_candidates": 20,
    "max_selected_sources": 5,
    "max_video_duration_sec": 3600,
    "max_model_calls": 100,
    "max_estimated_cost_usd": 10.0,
    "max_runtime_sec": 3600,
    "reuse_cache": true,
    "refresh_cache": false,
    "judge_difficulty": "standard"
  },
  "search": {
    "cache_ttl_sec": 86400,
    "timeout_sec": 15,
    "max_queries": 4,
    "per_provider_results": 10,
    "bilibili_search_url": "https://api.bilibili.com/x/web-interface/search/type",
    "bilibili_web_search_url": "https://search.bilibili.com/all",
    "github_api_url": "https://api.github.com",
    "github_token_env": "GITHUB_TOKEN",
    "searxng_base_url": "",
    "use_newapi_query_expansion": false,
    "use_newapi_candidate_assessment": false
  }
}
